# Anthropic API key used by the agent execution harness to generate engagement artifacts.
ANTHROPIC_API_KEY=

# SQLite connection. Local dev: a file: URL (created automatically). Production on Vercel:
# a Turso (libSQL) URL, e.g. libsql://fde-delivery-os-<org>.turso.io, since Vercel's serverless
# filesystem is read-only/ephemeral and cannot host a persistent SQLite file.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
