# ─── Models ───────────────────────────────────────────────────────────────
# At least ONE of the two is required. The pipeline calls Gemini first and
# falls back to Claude automatically when Gemini errors, is rate-limited, or
# has no key configured — so setting only one of them is a valid setup.
#
# Gemini (primary)  — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (fallback) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────
# Local development: leave this as-is. The file is created for you by
# `npm run db:migrate` and is gitignored.
DATABASE_URL=file:./local.db

# Production only. Vercel's serverless filesystem is ephemeral and read-only,
# so a local SQLite file cannot survive there. Point DATABASE_URL at a Turso
# (libSQL) database instead — libsql://<db>-<org>.turso.io — and put that
# database's token here. It must be the database token, not the Turso
# platform/API token: the latter authenticates but returns 401 on queries.
DATABASE_AUTH_TOKEN=
